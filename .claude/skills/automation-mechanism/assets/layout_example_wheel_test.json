{
  "title": "滚轮模组手感测试工作站 3D 概念布局",
  "components": [
    {"id": "frame", "type": "frame", "name": "机架", "size": [1200, 800, 850], "style": "legs"},
    {"id": "guard", "type": "enclosure", "name": "防护罩", "size": [1200, 800, 1000], "open_front": true},

    {"id": "shuttle", "type": "linear_module", "name": "料盘穿梭模组", "at": [-420, -200], "rot": 90,
     "stroke": 250, "pos": 1, "payload": [200, 150, 45]},
    {"id": "tray", "type": "tray", "name": "来料料盘", "at": "shuttle.carriage", "size": [200, 150, 20]},
    {"id": "part_in", "type": "product", "name": "待测模组", "at": "tray.center",
     "product": {"shape": "box", "size": [40, 30, 25]}},

    {"id": "fixture", "type": "box", "name": "测试治具", "at": [0, 50], "size": [120, 100, 100]},
    {"id": "dut", "type": "product", "name": "测试中模组", "at": "fixture.top",
     "product": {"shape": "box", "size": [40, 30, 25]}},
    {"id": "test_slide", "type": "linear_module", "name": "测试头进给模组", "at": [0, -200], "rot": 90,
     "stroke": 60, "pos": 1, "payload": [60, 120, 60]},
    {"id": "tester", "type": "box", "name": "伺服+扭矩传感器", "at": "test_slide.carriage",
     "size": [60, 120, 60], "color": "#2b2f36"},
    {"id": "coupling", "type": "cylinder", "name": "滚轮驱动轴", "at": [0, -22.5, 101], "rot": 90,
     "d": 20, "h": 110, "axis": "x", "color": "#8b97a5", "touch": ["tester"]},

    {"id": "load", "type": "pick_place", "name": "上料取放 (模组)", "from": "part_in.top", "to": "dut.top",
     "drive": "module", "z_stroke": 40, "post_side": "left", "post_at": "start", "side": 160, "pos": 0},

    {"id": "conv", "type": "conveyor", "name": "出料皮带线", "at": [150, -180], "length": 400,
     "width": 100, "height": 100},
    {"id": "unload", "type": "pick_place", "name": "下料取放 (气缸)", "from": "dut.top", "to": "conv.start",
     "drive": "cylinder", "z_stroke": 40, "side": 150, "post_at": "start", "pos": 1},
    {"id": "ng_push", "type": "cylinder_actuator", "name": "NG 推料气缸", "bore": 16, "stroke": 80,
     "tip": {"ref": "conv.mid", "offset": [0, 40, 25]}, "dir": 90, "head_size": [10, 30, 15]},
    {"id": "ng_bin", "type": "bin", "name": "NG 料盒 (带锁)", "at": [350, -50], "size": [120, 100, 80]},

    {"id": "curtain", "type": "light_curtain", "name": "前侧安全光栅", "at": [0, -410], "span": 1000,
     "height": 600, "z0": 50},
    {"id": "hmi", "type": "hmi", "name": "触摸屏", "at": [625, -380, 520], "arm": 90, "touch": ["guard"]},
    {"id": "tower", "type": "tower_light", "name": "三色灯", "at": [-570, 370, 1000]}
  ]
}
